# =============================================================================
# Language Hub — environment variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local`, fill in your real values, and DO NOT commit
# the real `.env.local` file. These are annotated examples only — no real
# secrets live here.
#
# Every variable listed below is read by the codebase. Anything not listed is
# not implemented — please don't add aspirational keys.
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
# Production / any shared deployment: point DATABASE_URL at a real PostgreSQL
# server (Neon here). The pooled URL serves application traffic; the direct
# (unpooled) URL is used only for the schema bootstrap / migrations.
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Optional: override TLS mode ("disable" | "require" | "verify-full").
# PGSSLMODE=require

# Local development: leave DATABASE_URL unset and the app runs the real
# PostgreSQL engine in-process via PGlite, persisted to a data directory.
# LANGUAGE_HUB_PG_DIR=.pgdata

# Salt for the non-reversible "helpful" vote fingerprint. When unset it falls
# back to AUTH_SECRET, which is safe — never set it to a public value.
# LANGUAGE_HUB_HASH_SALT=

# --- Public academy / contact details --------------------------------------
# Defaults shown across the site. Admin → Settings → Academy profile overrides
# these on the public Contact page without a redeploy.
NEXT_PUBLIC_ACADEMY_WHATSAPP=+923001234567
NEXT_PUBLIC_ACADEMY_PHONE=+923001234567
NEXT_PUBLIC_ACADEMY_EMAIL=hello@languagehub.example
NEXT_PUBLIC_ACADEMY_CITY=Islamabad
# Optional street address + map link (used by the footer and JSON-LD).
# NEXT_PUBLIC_ACADEMY_ADDRESS=
# NEXT_PUBLIC_ACADEMY_MAP=

# --- Admin bootstrap (used only if no admin exists yet) --------------------
ADMIN_EMAIL=admin@languagehub.example
ADMIN_PASSWORD=change-me-strong-password
ADMIN_ACCESS_CODE=change-me-access-code

# --- Auth (NextAuth / Auth.js v5) ------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-byte-secret
NEXTAUTH_SECRET=replace-with-random-32-byte-secret
# Canonical site URL used for callbacks/emails.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Social / OAuth login (optional) ----------------------------------------
# Providers activate AUTOMATICALLY when the client id + secret pair is present.
# "Continue with Google" button also needs NEXT_PUBLIC_GOOGLE_ENABLED=true
# (see components/auth/OAuthButtons). Redirect URI to register in each console:
#   https://<your-domain>/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/github
#   https://<your-domain>/api/auth/callback/microsoft-entra-id
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- SMTP (transactional email) ---------------------------------------------
# Gmail SMTP is supported: host smtp.gmail.com, port 587, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=languagehub.team@gmail.com
SMTP_PASS=replace-with-google-app-password
MAIL_FROM="Language Hub <languagehub.team@gmail.com>"

# --- Course registration notifications --------------------------------------
# Inbox that receives a generated PDF summary for every course registration.
# Defaults to the studio inbox if unset.
REGISTRATION_NOTIFY_EMAIL=languagehub.team@gmail.com

# --- AI (optional) ----------------------------------------------------------
# LLM key for the AI features (placement-test analysis). When empty, the app
# runs a deterministic offline mode so nothing breaks.
AI_API_KEY=replace-with-llm-key
# Chat model used by the analyzer and coach.
#   OpenAI default:            gpt-4o-mini
#   Groq (free, no card):      llama-3.3-70b-versatile   + AI_BASE_URL=https://api.groq.com/openai/v1
#   DeepSeek (very cheap):     deepseek-chat             + AI_BASE_URL=https://api.deepseek.com
AI_MODEL=gpt-4o-mini
# Optional: point the chat model at any OpenAI-compatible gateway.
# AI_BASE_URL=https://api.groq.com/openai/v1

# --- Error monitoring / alerts (optional) -----------------------------------
# Discord/Slack/Telegram "incoming webhook" URL. When set, every captured
# `error`-level event is also pushed here (throttled).
# ERROR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- Fortress shield (active defense) ---------------------------------------
# Edge WAF: blocks XSS/SQLi/path-traversal/recon probes + honeypot paths,
# registers per-client strikes and tarpits repeat offenders.
# SHIELD_STRIKE_LIMIT=5
# SHIELD_BLOCK_MS=600000
# Optional override token for the internal /api/security/event sink
# (defaults to AUTH_SECRET).
# SHIELD_TOKEN=

# --- Proxy / client identity ------------------------------------------------
# Set to 1 only behind a trusted reverse proxy (Vercel sets the real client IP
# headers). Without it, forwarded headers are ignored so they cannot be spoofed.
# TRUST_PROXY=1

# --- Analytics (optional) ---------------------------------------------------
# Self-hosted or third-party script injected on the public site.
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://analytics.example/script.js
