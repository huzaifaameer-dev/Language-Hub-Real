# =============================================================================
# Language Hub — environment variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local`, fill in your real values, and DO NOT commit
# the real `.env.local` file. These are annotated examples only — no real
# secrets live here.
# =============================================================================

# --- MongoDB ---------------------------------------------------------------
# Connection string for your MongoDB instance/Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name used by the app.
MONGODB_DB=languagehub

# --- Public academy / contact details --------------------------------------
# Shown across the site and used for WhatsApp/call/email CTAs. Public, not secret.
NEXT_PUBLIC_ACADEMY_WHATSAPP=+923001234567
NEXT_PUBLIC_ACADEMY_PHONE=+923001234567
NEXT_PUBLIC_ACADEMY_EMAIL=hello@languagehub.example
NEXT_PUBLIC_ACADEMY_CITY=Islamabad

# --- Admin bootstrap (used only if no admin exists yet) --------------------
ADMIN_EMAIL=admin@languagehub.example
ADMIN_PASSWORD=change-me-strong-password
ADMIN_ACCESS_CODE=change-me-access-code

# --- Auth (NextAuth) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-byte-secret
NEXTAUTH_SECRET=replace-with-random-32-byte-secret
# Canonical site URL used for callbacks/emails.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Automations ------------------------------------------------------------
# Shared secret that guards the /api/automations endpoint.
AUTOMATION_SECRET=replace-with-random-automation-secret
# "true" enables the in-process interval runner (default off).
ENABLE_AUTOMATION_INTERVAL=false

# --- Payments: Stripe -------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Payments: Konnect ------------------------------------------------------
KONNECT_MERCHANT_ID=replace-with-merchant-id
KONNECT_SECRET_KEY=replace-with-konnect-secret
# Secret used to HMAC-sign Konnect webhook callbacks. Falls back to
# KONNECT_SECRET_KEY when unset. Set this in prod — webhook signatures are
# verified and rejecting when it is missing.
KONNECT_WEBHOOK_SECRET=replace-with-konnect-webhook-secret

# --- WhatsApp Cloud API / webhook ------------------------------------------
# WA_API_URL is optional and defaults to the Meta Cloud API:
#   https://graph.facebook.com/v18.0
# To use a different provider (Twilio, 360dialog, Gupshup…), set WA_API_URL to
# that provider's base endpoint; the app POSTs the standard Cloud API message
# shape to `<WA_API_URL>/<phone-id>/messages` with a `Bearer WA_TOKEN`.
#   WA_API_URL=https://your-provider.example
WA_TOKEN=replace-with-whatsapp-token
WA_WEBHOOK_TOKEN=replace-with-webhook-verify-token
WA_PHONE_NUMBER=+923001234567

# --- Error monitoring / alerts (optional) ----------------------------------
# Discord/Slack/Telegram "incoming webhook" URL. When set, every captured
# `error`-level event is also pushed here (throttled). Leave blank to store
# errors in the Mongo `errors` collection only.
#   ERROR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- SMTP (transactional email) ---------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM="Language Hub <noreply@languagehub.example>"

# --- AI (optional) ----------------------------------------------------------
# LLM key for the AI features: placement-test analysis, the English tutor
# chatbot (RAG), essay/speaking feedback, and the admin weekly agent. When
# empty, every AI feature runs a deterministic offline mode so the app still
# works.
AI_API_KEY=replace-with-llm-key
# Chat/agent model used by the tutor, analyzer, feedback and weekly agent.
#   OpenAI default:            gpt-4o-mini
#   Groq (free, no card):      llama-3.3-70b-versatile   + AI_BASE_URL=https://api.groq.com/openai/v1
#   DeepSeek (very cheap):     deepseek-chat             + AI_BASE_URL=https://api.deepseek.com
AI_MODEL=gpt-4o-mini
# Optional: point the chat model at any OpenAI-compatible gateway.
#   AI_BASE_URL=https://api.groq.com/openai/v1
# Embedding model for the RAG knowledge base (course syllabus + FAQ + blog).
AI_EMBEDDING_MODEL=text-embedding-3-small
# Optional separate OpenAI-style embedding endpoint. Only needed when chat and
# embeddings use different providers (Groq/DeepSeek have no embedding API — the
# tutor then auto-falls back to keyword search over the syllabus):
#   AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
#   AI_EMBEDDING_API_KEY=sk-...
# Vector retrieval mode:
#   local  → cosine similarity computed in-process over stored embeddings (default; works anywhere)
#   atlas  → MongoDB Atlas $vectorSearch pipeline (requires an Atlas cluster)
AI_VECTOR_MODE=local

# --- Fortress shield (active defense) -----------------------------------------
# Edge WAF: blocks XSS/SQLi/path-traversal/recon probes + honeypot paths,
# registers per-client strikes and tarpits repeat offenders.
#   SHIELD_STRIKE_LIMIT=5
#   SHIELD_BLOCK_MS=600000
# Optional override token for the internal /api/security/event sink
# (defaults to AUTH_SECRET).
#   SHIELD_TOKEN=

# --- AI daily budget ----------------------------------------------------------
# Public AI (guide/practice/feedback) quota per client per day.
#   AI_DAILY_CAP=60

# --- Autonomous AI admin agent (optional, OFF by default) --------------------
# Turn ON to let the background cron autonomously operate the business queues
# (applications -> enroll -> payments -> blog). When OFF the agent idles and
# never touches data. Set AI_AGENT_ENABLED=1 to enable.
#   AI_AGENT_ENABLED=0
# Decision mode: the agent autonomously approves clean applications/enrollments,
# sends payment requests, confirms proofs and handles demo bookings/blog.
#   AI_AGENT_MODE=auto
# Owner safety switch: set AI_AGENT_AUTO=0 to disable all AI auto-decisions —
# the agent then only FLAGS items for human review (never approves/rejects).
#   AI_AGENT_AUTO=1
# Optional: weekly self-published AI blog post (from a rotating course topic).
#   AI_AGENT_BLOG=0
