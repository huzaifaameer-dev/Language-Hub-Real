# =============================================================================
# Language Hub — environment variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local`, fill in your real values, and DO NOT commit
# the real `.env.local` file. These are annotated examples only — no real
# secrets live here.
# =============================================================================

# --- MongoDB ---------------------------------------------------------------
# Connection string for your MongoDB instance/Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name used by the app.
MONGODB_DB=languagehub

# --- Public academy / contact details --------------------------------------
# Shown across the site and used for WhatsApp/call/email CTAs. Public, not secret.
NEXT_PUBLIC_ACADEMY_WHATSAPP=+923001234567
NEXT_PUBLIC_ACADEMY_PHONE=+923001234567
NEXT_PUBLIC_ACADEMY_EMAIL=hello@languagehub.example
NEXT_PUBLIC_ACADEMY_CITY=Islamabad

# --- Admin bootstrap (used only if no admin exists yet) --------------------
ADMIN_EMAIL=admin@languagehub.example
ADMIN_PASSWORD=change-me-strong-password
ADMIN_ACCESS_CODE=change-me-access-code

# --- Auth (NextAuth) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-byte-secret
NEXTAUTH_SECRET=replace-with-random-32-byte-secret
# Canonical site URL used for callbacks/emails.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Automations ------------------------------------------------------------
# Shared secret that guards the /api/automations endpoint.
AUTOMATION_SECRET=replace-with-random-automation-secret
# "true" enables the in-process interval runner (default off).
ENABLE_AUTOMATION_INTERVAL=false

# --- Payments: Stripe -------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Payments: Konnect ------------------------------------------------------
KONNECT_MERCHANT_ID=replace-with-merchant-id
KONNECT_SECRET_KEY=replace-with-konnect-secret

# --- WhatsApp Cloud API / webhook ------------------------------------------
WA_TOKEN=replace-with-whatsapp-token
WA_WEBHOOK_TOKEN=replace-with-webhook-verify-token
WA_PHONE_NUMBER=+923001234567

# --- SMTP (transactional email) ---------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM="Language Hub <noreply@languagehub.example>"
